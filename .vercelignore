# Keep local sources, device wrappers, and validation material out of the browser release.
.git/
.worktrees/
.superpowers/
.vercel/
node_modules/
android/
tools/
docs/
test/
output/
infra/
scripts/

# Exclude raw art catalogs and binary output by default. This release worktree
# contains only the vetted AAA art listed below, so its GLBs must remain public.
public/assets/nightfall/png-collection/
public/assets/nightfall/reference/
*.zip
*.apk
*.crdownload

# Keep the compact survivor fallback models available offline.
!public/assets/nightfall/characters/
!public/assets/nightfall/characters/3d/
!public/assets/nightfall/characters/3d/*.glb

# Curated production 3D art: survivors, enemy roster, weapons, and world props.
