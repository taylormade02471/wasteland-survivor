        "runtimeImport": false
      }
    },
    {
      "id": "wasteland-survivor.facial.neutral-listen",
      "category": "facial",
      "owner": "facial-animation",
      "clipName": "facial-neutral-listen",
      "binding": {
        "controllerHook": "createPoseController.update",
        "characterPoseState": "idle"
      },
      "capture": {
        "loop": true,
        "rootMotion": "not-applicable",
        "facialTrack": "required",
        "runtimeSupport": "capture-only",
        "runtimeImport": false
      }
    },
    {
      "id": "wasteland-survivor.facial.aim-focus",
